{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node build.js",
  "installCommand": "npm install --omit=dev",
  "outputDirectory": "dist/site",
  "framework": null,
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/app/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/app/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/app/",
      "permanent": false
    },
    {
      "source": "/index.html",
      "destination": "/app/",
      "permanent": false
    },
    {
      "source": "/app",
      "destination": "/app/",
      "permanent": true
    },
    {
      "source": "/book",
      "destination": "/book/",
      "permanent": true
    },
    {
      "source": "/book/hi",
      "destination": "/book/hi/",
      "permanent": true
    },
    {
      "source": "/plan",
      "destination": "/plan/",
      "permanent": true
    },
    {
      "source": "/worksheet",
      "destination": "/worksheet/",
      "permanent": true
    },
    {
      "source": "/worksheet/hi",
      "destination": "/worksheet/hi/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/llm",
      "destination": "/api/health?relay=1"
    }
  ]
}

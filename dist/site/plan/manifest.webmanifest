{
  "id": "/plan/",
  "name": "Applied AI PM plan",
  "short_name": "AI PM Plan",
  "description": "The 26-week route, week by week, with shared progress.",
  "start_url": "/plan/",
  "scope": "/plan/",
  "display": "standalone",
  "orientation": "any",
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://relevel-steel.vercel.app/plan/manifest.webmanifest"
    }
  ],
  "prefer_related_applications": false,
  "background_color": "#ECEEEA",
  "theme_color": "#ECEEEA",
  "icons": [
    {
      "src": "/plan/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/plan/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/plan/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}